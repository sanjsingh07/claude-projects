{
  "expo": {
    "name": "Stellar Align",
    "owner": "nublet",
    "slug": "stellar-align",
    "scheme": [
      "stellar-align",
      "com.googleusercontent.apps.945791078641-ena3npefg2g7e4fs6vhsna4e0qkfouof"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellaralign.app",
      "appleTeamId": "U3C4PQ94A6",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": true,
      "package": "com.stellaralign.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "225aeb82-3b52-4134-bcff-729b3ab00c5b"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ]
  }
}
