{
  "expo": {
    "name": "Stellar Align",
    "owner": "nublet",
    "slug": "stellar-align",
    "scheme": "stellar-align",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellaralign.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "AllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "package": "com.stellaralign.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://192.168.29.146:3000/api",
      "eas": {
        "projectId": "225aeb82-3b52-4134-bcff-729b3ab00c5b"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ]
  }
}
