generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum HouseSystem {
  PLACIDUS
  KOCH
  WHOLE_SIGN
  EQUAL
  PORPHYRY
}

enum ZodiacType {
  TROPICAL
  SIDEREAL
}

enum AyanamsaType {
  LAHIRI
  RAMAN
  KRISHNAMURTI
  FAGAN_BRADLEY
}

enum DivisionalChartType {
  D1
  D2
  D4
  D9
  D10
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum GeneratedBy {
  CLAUDE
  RULE_BASED
  SYSTEM
}

enum ChatRole {
  USER
  ASSISTANT
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  emailVerified         Boolean   @default(false)
  passwordHash          String?
  authProvider          AuthProvider @default(EMAIL)
  providerId            String?
  displayName           String?
  gender                Gender?
  bio                   String?
  avatarUrl             String?
  birthDateTime         DateTime
  birthTimeUnknown      Boolean   @default(false)
  birthLocationName     String?
  birthLatitude         Float?
  birthLongitude        Float?
  birthTimezone         String
  birthUtcOffset        Int?
  notificationSettings  Json      @default("{\"pushTime\": \"09:00\", \"marketing\": false, \"transitAlerts\": true, \"dailyHoroscope\": true, \"friendActivity\": false}")
  privacySettings       Json      @default("{\"chartVisible\": \"friends\", \"profileVisible\": true, \"allowCompatibility\": true}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?
  lastActiveAt          DateTime  @default(now())
  isActive              Boolean   @default(true)
  isDeleted             Boolean   @default(false)
  profileCompleted      Boolean   @default(false)
  isPremium             Boolean   @default(false)
  subscriptionExpiresAt DateTime?
  deletedAt             DateTime?
  requestedCompat       CompatibilityReport[] @relation("RequesterCompat")
  addresseeCompat       CompatibilityReport[] @relation("AddresseeCompat")
  horoscopes            DailyHoroscope[]
  passwordResetTokens   PasswordResetToken[]
  receivedFriendships   Friendship[] @relation("Addressee")
  sentFriendships       Friendship[] @relation("Requester")
  natalChart            NatalChart?
  notifications         Notification[]
  pushTokens            PushToken[]
  settings              UserSettings?

  @@index([email])
  @@index([authProvider, providerId])
  @@index([birthDateTime])
}

model UserSettings {
  id                    String    @id @default(uuid())
  userId                String    @unique
  chartStyle            String    @default("western")
  defaultDivisionalChart DivisionalChartType @default(D1)
  darkMode              Boolean   @default(true)
  accentColor           String    @default("violet")
  
  // Notification flags
  dailyReadingEnabled   Boolean   @default(true)
  dailyReadingTime      String    @default("08:00")
  transitAlertsEnabled  Boolean   @default(true)
  transitAlertsLevel    String    @default("major")
  compatibilityEnabled  Boolean   @default(false)
  compatibilityFreq     String    @default("weekly")
  birthdayRemindersEnabled Boolean @default(true)
  
  // Privacy flags
  shareBirthData        Boolean   @default(false)
  analyticsEnabled      Boolean   @default(true)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NatalChart {
  id                    String    @id @default(uuid())
  userId                String    @unique
  sunSign               ZodiacSign
  moonSign              ZodiacSign
  risingSign            ZodiacSign?
  chartPattern          String?
  calculationMethod     String    @default("swiss_ephemeris")
  houseSystem           HouseSystem @default(PLACIDUS)
  zodiacType            ZodiacType @default(SIDEREAL)
  ayanamsa              AyanamsaType @default(LAHIRI)
  nakshatra             String?
  nakshatraPada         Int?
  nakshatraLord         String?
  calculatedAt          DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planetaryPositions    NatalPlanetPosition[]
  divisionalCharts      DivisionalChart[]
  houses                NatalHouseCusp[]
  aspects               NatalAspect[]

  @@index([userId])
  @@index([sunSign, moonSign, risingSign])
}

model NatalPlanetPosition {
  id           String     @id @default(uuid())
  natalChartId String
  planet       String     // e.g., "SUN", "MOON"
  sign         ZodiacSign
  longitude    Float
  latitude     Float
  distance     Float
  speed        Float
  degree       Int
  minute       Int
  house        Int?
  retrograde   Boolean    @default(false)
  
  natalChart   NatalChart @relation(fields: [natalChartId], references: [id], onDelete: Cascade)

  @@unique([natalChartId, planet])
  @@index([planet, sign])
}

model NatalHouseCusp {
  id           String     @id @default(uuid())
  natalChartId String
  house        Int        // 1-12
  sign         ZodiacSign
  longitude    Float
  degree       Int
  minute       Int
  
  natalChart   NatalChart @relation(fields: [natalChartId], references: [id], onDelete: Cascade)

  @@unique([natalChartId, house])
}

model NatalAspect {
  id           String     @id @default(uuid())
  natalChartId String
  planet1      String
  planet2      String
  type         String
  angle        Float
  orb          Float
  applying     Boolean
  
  natalChart   NatalChart @relation(fields: [natalChartId], references: [id], onDelete: Cascade)

  @@index([natalChartId])
}

model DivisionalChart {
  id                  String   @id @default(uuid())
  natalChartId        String
  chartType           DivisionalChartType
  ascendant           ZodiacSign
  ascendantDegree     Float
  createdAt           DateTime @default(now())
  
  natalChart          NatalChart @relation(fields: [natalChartId], references: [id], onDelete: Cascade)
  planetaryPositions  DivisionalPlanetPosition[]
  houses              DivisionalHouseCusp[]

  @@index([natalChartId])
  @@index([chartType])
}

model DivisionalPlanetPosition {
  id                String          @id @default(uuid())
  divisionalChartId String
  planet            String
  sign              ZodiacSign
  degree            Float
  house             Int
  retrograde        Boolean         @default(false)
  combust           Boolean         @default(false)
  
  divisionalChart   DivisionalChart @relation(fields: [divisionalChartId], references: [id], onDelete: Cascade)

  @@unique([divisionalChartId, planet])
}

model DivisionalHouseCusp {
  id                String          @id @default(uuid())
  divisionalChartId String
  house             Int
  sign              ZodiacSign
  degree            Float
  
  divisionalChart   DivisionalChart @relation(fields: [divisionalChartId], references: [id], onDelete: Cascade)

  @@unique([divisionalChartId, house])
}

model DailyHoroscope {
  id                  String    @id @default(uuid())
  userId              String
  forDate             DateTime
  moonSign            ZodiacSign?
  moonPhase           String?
  activeTransits      Json?
  generationMeta      Json?     // Added to store system info, Vedic details, etc.
  energyScore         Int?
  moodAspects         Json?
  primaryTransit      Json?
  aspects             Json?
  contentSelf         String
  contentWork         String
  contentLove         String
  contentSocial       String
  generatedBy         GeneratedBy @default(CLAUDE)
  generationVersion   Int       @default(1)
  viewedAt            DateTime?
  shared              Boolean   @default(false)
  bookmarked          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, forDate])
  @@index([userId, forDate])
}

model Transit {
  id            String   @id @default(uuid())
  transitPlanet String
  natalPlanet   String?
  targetSign    ZodiacSign?
  aspectType    String?
  startDate     DateTime
  exactDate     DateTime?
  endDate       DateTime
  description   String
  intensity     Int
  appliesToSigns String[]

  @@index([startDate, endDate])
}

model Friendship {
  id            String   @id @default(uuid())
  requesterId   String
  addresseeId   String
  status        FriendshipStatus @default(PENDING)
  createdAt     DateTime @default(now())
  acceptedAt    DateTime?
  addressee     User     @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester     User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

model CompatibilityReport {
  id                String    @id @default(uuid())
  user1Id           String
  user2Id           String
  overallScore      Float
  scores            Json
  synastryAspects   Json?
  compositeChartId  String?
  interpretation    String?
  strengths         Json?
  challenges        Json?
  advice            String?
  generatedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user1             User      @relation("RequesterCompat", fields: [user1Id], references: [id], onDelete: Cascade)
  user2             User      @relation("AddresseeCompat", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String
  platform   String
  deviceId   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  data        Json?
  sentAt      DateTime @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?
  pushTokenId String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentTemplate {
  id           String   @id @default(uuid())
  category     String
  sign         ZodiacSign?
  aspectPattern String?
  moonPhase    String?
  templateText String
  tone         String   @default("balanced")
  intensity    Int
  usageCount   Int      @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  @@index([category, sign])
}

model JobLog {
  id         String   @id @default(uuid())
  jobType    String
  status     String
  payload    Json?
  result     Json?
  errorMessage String?
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([jobType])
  @@index([status])
}

model AnalyticsEvent {
  id            String   @id @default(uuid())
  userId        String?
  eventType     String
  eventCategory String?
  eventData     Json?
  sessionId     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  isCleared Boolean  @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  sessionId  String
  role       ChatRole
  content    String
  createdAt  DateTime @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

